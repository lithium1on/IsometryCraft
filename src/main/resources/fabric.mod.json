{
  "schemaVersion": 1,
  "id": "isometrycraft",
  "version": "${version}",
  "name": "IsometryCraft",
  "description": "Experience Minecraft from a true isometric perspective.",
  "authors": [
    "Bryce3345",
    "lithium1on (26.3 port)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/isometrycraft",
    "sources": "https://github.com/lithium1on/IsometryCraft"
  },
  "license": "MIT",
  "icon": "assets/isometrycraft/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.bryce.IsometryCraft"
    ],
    "client": [
      "com.bryce.client.IsometryCraftClient"
    ],
    "fabric-datagen": [
      "com.bryce.client.IsometryCraftDataGenerator"
    ],
    "modmenu": [
      "com.bryce.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "isometrycraft.mixins.json",
    {
      "config": "isometrycraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3.159"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  }
}
